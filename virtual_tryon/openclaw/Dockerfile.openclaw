FROM node:22-slim

# Install OpenClaw CLI
RUN npm install -g openclaw@2026.6.5 && \
    mkdir -p /home/node/.openclaw && \
    chown -R node:node /home/node

# Workspace is mounted at /workspace at runtime (see docker-compose.yml)
# Config is mounted at /home/node/.openclaw/openclaw.json

EXPOSE 5789

HEALTHCHECK --interval=15s --timeout=10s --retries=5 --start-period=30s \
    CMD node -e "require('http').get({host:'localhost',port:5789,path:'/'}, r => process.exit(r.statusCode < 500 ? 0 : 1)).on('error', () => process.exit(1))"

USER node

ENTRYPOINT ["openclaw", "gateway", "--port", "5789"]
