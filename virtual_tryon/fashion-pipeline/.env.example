# Fashion Pipeline — environment variables
# Copy to .env and fill in your values.

# ── LLM (styling tips) ───────────────────────────────────────────────────────
# Local Ollama endpoint. The pipeline fails if this service is unavailable.
LLM_API_BASE=http://ollama:11434/v1
LLM_MODEL=qwen3.6:27b

# ── ACE-Step music (optional) ─────────────────────────────────────────────────
ACESTEP_API_KEY=fashion-dev-token
SKIP_MUSIC=0
MUSIC_PROMPT=

# ── FASHN virtual try-on servers ──────────────────────────────────────────────
FASHN_SERVER_URLS=http://fashn0:7860,http://fashn1:7861

# ── Input / output directories ───────────────────────────────────────────────
# Mount garment catalogue plus demo videos into /app/input.
INPUT_DIR=../catalogue
DEMO_VIDEOS_DIR=./demo-videos
OUTPUT_DIR=./output

# ── Hugging Face cache (for DWPose + fashn_vton weights) ────────────────────
HF_CACHE_DIR=~/.cache/huggingface

# ── Pipeline tuning ──────────────────────────────────────────────────────────
# Budget profile for two parallel top+bottom outfits under the 90s target.
NUM_FRAMES=4
CANDIDATE_FRAMES=12
FRAME_DURATION=2.5
TIMESTEPS=8
SEED=42
