# ============================================================
# Retail Virtual Try-On Platform — Environment Template
# Copy to .env and fill in ALL values marked REQUIRED.
# setup.sh scaffolds this automatically — run it instead of
# editing by hand unless you know what you're doing.
# ============================================================

# ------------------------------------------------------------
# Database  (REQUIRED)
# ------------------------------------------------------------
POSTGRES_PASSWORD=
# Full DSN used by vto-api and vto-mcp; setup.sh builds this
# from POSTGRES_PASSWORD once you set it above.
DATABASE_URL=

# ------------------------------------------------------------
# Object store — RustFS / Milvus  (REQUIRED)
# ------------------------------------------------------------
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ------------------------------------------------------------
# Host cache directories  (REQUIRED — set to your local paths)
# ------------------------------------------------------------
HF_CACHE_DIR=
OLLAMA_DATA_DIR=
# Lemonade/Kokoro TTS's own cache, kept separate from HF_CACHE_DIR since that
# service runs as root and would otherwise leave root-owned files behind.
LEMONADE_CACHE_DIR=

# ------------------------------------------------------------
# ACE-Step build & cache paths  (REQUIRED)
# ------------------------------------------------------------
# Absolute path to the fashion-slideshow directory containing
# the acestep.Dockerfile used to build the vto_acestep image.
ACESTEP_BUILD_CONTEXT=
# Path to the pre-downloaded ACE-Step model snapshot on the host.
ACESTEP_CACHE_DIR=

# ------------------------------------------------------------
# Security tokens  (REQUIRED — do not use defaults in production)
# ------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=
ACESTEP_API_KEY=

# ------------------------------------------------------------
# OpenClaw agent gateway
# ------------------------------------------------------------
OPENCLAW_GATEWAY_TIMEOUT=300
OPENCLAW_MAX_COMPLETION_TOKENS=1024
OPENCLAW_LLM_PROVIDER=ollama
OPENCLAW_LLM_MODEL=qwen3.6:27b
OPENCLAW_BACKEND_MODEL=

# ------------------------------------------------------------
# Ollama  (GPU 2 — via ollama-metrics proxy on :8080)
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama-metrics:8080
# Auto-generated by setup.sh — Ollama does not enforce auth locally, but a
# unique token is minted so the value is never left blank.
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen3.6:27b

# ------------------------------------------------------------
# OpenClaw Gateway tuning
# ------------------------------------------------------------
# Max response time for streaming agent chat (seconds).
# The frontend uses streaming mode; once this timeout is hit the
# deterministic catalog fallback is served automatically.
OPENCLAW_STREAM_TIMEOUT=50

# Max conversation turns forwarded to OpenClaw (default 5).
# Lower = smaller prompt = faster inference. Higher = more context.
OPENCLAW_MAX_TURNS=5

# Max garments to list when catalog search finds no semantic matches.
# Lower = smaller prompt = faster inference. Higher = more options.
VTO_CATALOG_FALLBACK_LIMIT=20

# Timeout for the LLM intent-extraction pre-flight call (seconds).
# If the local model is warm it usually finishes under this budget.
# If it times out we instantly fall back to rule-based heuristics.
OPENCLAW_INTENT_TIMEOUT=10

# ------------------------------------------------------------
# Fashion pipeline LLM
# ------------------------------------------------------------
LLM_API_BASE=http://ollama-metrics:8080/v1
LLM_MODEL=qwen3.6:27b

# ------------------------------------------------------------
# FASHN inference servers  (GPU 0 + GPU 1)
# ------------------------------------------------------------
FASHN_SERVER_URLS=http://fashn0:7860,http://fashn1:7861

# ------------------------------------------------------------
# Fashion pipeline generation parameters
# ------------------------------------------------------------
NUM_FRAMES=4
CANDIDATE_FRAMES=12
FRAME_DURATION=2.5
TIMESTEPS=8
SEED=42
SKIP_MUSIC=0
MUSIC_PROMPT=

# ------------------------------------------------------------
# Fashion pipeline I/O directories  (relative to repo root)
# ------------------------------------------------------------
INPUT_DIR=./catalogue
DEMO_VIDEOS_DIR=./virtual_tryon/fashion-pipeline/demo-videos
OUTPUT_DIR=./virtual_tryon/fashion-pipeline/output

# ------------------------------------------------------------
# TTS  (Lemonade / Kokoro — CPU-only)
# ------------------------------------------------------------
VTO_TTS_MODEL=kokoro-v1
VTO_TTS_VOICE=af_bella
VTO_TTS_TIMEOUT=300
# CPU cores to pin Lemonade/Kokoro to (e.g. "1-16"), or empty for unrestricted.
# setup.sh auto-detects a safe value for the host — do not hardcode a range
# from another machine here.
TTS_CPUSET=

# ------------------------------------------------------------
# Hugging Face  (REQUIRED — gated model access for FASHN/ACE-Step)
# ------------------------------------------------------------
HF_TOKEN=

# ------------------------------------------------------------
# Optional HTTPS (self-signed) — needed for mic/voice input when
# accessing the frontend via a LAN IP (browsers require a secure
# context for getUserMedia). http:// and https:// share the same
# frontend port (nginx sniffs the connection and routes accordingly),
# so enabling this does not open a second port. setup.sh's HTTPS
# prompt defaults to enabling this and generates the cert; these
# plain-HTTP values are only the fallback if setup.sh is skipped.
# ------------------------------------------------------------
TLS_ENABLED=0
NGINX_CONF=./frontend/nginx.conf
TLS_CERT_DIR=./frontend/tls/disabled-certs

# ------------------------------------------------------------
# Frontend port  (host side only — container always listens on 5173)
# ------------------------------------------------------------
GATEWAY_HTTP_ALT_PORT=5173

# ------------------------------------------------------------
# ROCm  (auto-set by setup.sh — override only if needed)
# ------------------------------------------------------------
HSA_OVERRIDE_GFX_VERSION=12.0.1
ROCR_VISIBLE_DEVICES=0,1,2,3

# ------------------------------------------------------------
# GPU device group GIDs  (auto-detected by setup.sh)
# These control container access to /dev/kfd and /dev/dri.
# ------------------------------------------------------------
VIDEO_GID=44
RENDER_GID=109
